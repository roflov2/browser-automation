# Copy to .env and fill in. .env is git-ignored. Requires Python 3.11+.
# Read once at start-up by checkout_navigator/config.py; variables already set in the environment win over .env.

# --- Model (pick one) -------------------------------------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey (the default model is google/gemini-3.8-flash)
GOOGLE_GENERATIVE_AI_API_KEY=
# Or any model Stagehand supports, with its key, e.g. NAVIGATOR_MODEL=anthropic/<model> and MODEL_API_KEY=...
# NAVIGATOR_MODEL=google/gemini-3.8-flash
# MODEL_API_KEY=

# Or Azure OpenAI (needs: pip install -r requirements-azure.txt). Signs in with Microsoft Entra ID through
# DefaultAzureCredential (az login, or AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET); no API key.
# Setting the endpoint switches every model call to the deployment.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_MANAGED_IDENTITY=false

# --- Navigation -------------------------------------------------------------------------------------------------
# MAX_STEPS=15
# DEFAULT_ADDRESS=240 City Walk, Canberra ACT 2601
# SEARCH_ORIGIN=CBR
# SEARCH_DESTINATION=SYD
# SEARCH_CITY=Sydney
# SEARCH_GUESTS=1

# Placeholder shopper typed into contact / passenger / guest forms. Typed values reach the page as Stagehand
# variables, so they are never sent to the model. The default mobile is in ACMA's fictional-use range.
# PERSONA_TITLE=Mr
# PERSONA_FIRST_NAME=Alex
# PERSONA_LAST_NAME=Testbooking
# PERSONA_FULL_NAME=Alex Testbooking
# PERSONA_GENDER=Male
# PERSONA_DATE_OF_BIRTH=15/06/1988
# PERSONA_EMAIL=alex.testbooking@example.com
# PERSONA_PHONE=0491 570 156
# PERSONA_COUNTRY=Australia

# --- Browser ----------------------------------------------------------------------------------------------------
# HEADLESS=true
# CHROME_PATH=
# CHROME_PROFILE_DIR=.chrome-profile
# BROWSER_PROXY_SERVER=http://proxy.example:8080
# BROWSER_PROXY_BYPASS=localhost,127.0.0.1
