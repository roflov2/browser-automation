# Copy to .env and fill in. .env is git-ignored.

# Gemini API key from https://aistudio.google.com/apikey (GEMINI_API_KEY also works)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: run without a visible browser window
# HEADLESS=true

# Optional: path to Chrome/Chromium if it isn't found automatically
# CHROME_PATH=
