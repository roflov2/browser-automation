# Copy to .env and fill in. .env is git-ignored. Requires Python 3.11+.
# Every variable here is read once at start-up by audit/config.py (Settings); the environment wins over .env.

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: use an Azure OpenAI deployment instead of Gemini (needs: pip install -e ".[azure]").
# Signs in with Microsoft Entra ID through DefaultAzureCredential (az login, or AZURE_CLIENT_ID /
# AZURE_TENANT_ID / AZURE_CLIENT_SECRET for a service principal); no API key. Setting the endpoint switches the model.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Also try the managed identity of the Azure host this runs on (off by default)
# AZURE_OPENAI_MANAGED_IDENTITY=false

# Optional: run without a visible browser window
# HEADLESS=true

# Optional: path to the Chrome/Chromium executable for local runs (checked at start-up)
# CHROME_PATH=

# Optional: Browserbase credentials to run and record the session on Browserbase
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Optional: guest details typed into the airline booking form by the `virgin` workflow.
# Placeholders are used if unset. The run stops at the payment page and never pays.
# Names, date of birth, email and phone are never sent to the model or written to output files.
# PAX_TITLE=Mr
# PAX_FIRST_NAME=Alex
# PAX_LAST_NAME=Testbooking
# PAX_GENDER=Male
# PAX_DATE_OF_BIRTH=15 June 1988
# PAX_EMAIL=alex.testbooking@example.com
# PAX_PHONE=0400 000 000
# PAX_COUNTRY=Australia

# Optional: default delivery address for the `ubereats` workflow (overridden by --address)
# UBEREATS_ADDRESS=260 City Walk, Canberra ACT 2601
