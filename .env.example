# Copy to .env and fill in. .env is git-ignored.

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: run without a visible browser window
# HEADLESS=true

# Optional: path to Chrome/Chromium if it isn't found automatically
# CHROME_PATH=

# Optional: Browserbase credentials to run and record the session on Browserbase
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Optional: guest details typed into the airline booking form by airlines-virgin.py.
# Placeholders are used if unset. The run stops at the payment page and never pays.
# PAX_TITLE=Mr
# PAX_FIRST_NAME=Alex
# PAX_LAST_NAME=Testbooking
# PAX_GENDER=Male
# PAX_DATE_OF_BIRTH=15 June 1988
# PAX_EMAIL=alex.testbooking@example.com
# PAX_PHONE=0400 000 000
# PAX_COUNTRY=Australia
